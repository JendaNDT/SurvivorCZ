; Engine configuration file.
; Dobyj Česko! – survivor strategie pro Android (Godot 4.5)

config_version=5

[application]

config/name="Dobyj Česko!"
config/description="Survivor strategie: podmaň si všech 14 krajů Česka."
config/version="1.2.2"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.16, 0.42, 0.68, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"
config/quit_on_go_back=false
run/flush_stdout_on_print=true

[autoload]

Art="*res://scripts/autoload/art.gd"
Baker="*res://scripts/autoload/baker.gd"
Game="*res://scripts/autoload/game.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.16, 0.42, 0.68, 1)
textures/vram_compression/import_etc2_astc=true
